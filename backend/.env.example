# Application environment variables

# ── App ──
APP_NAME=课程论文个人检测平台
DEBUG=true

# ── Database ──
DB_USER=
DB_PASSWORD=
DB_DSN=

# ── JWT ──
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# ── File upload ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800

# ── Detection ──
DETECTION_ADAPTER=mock

# ── Frontend ──
FRONTEND_URL=http://localhost:5183
